# ICTFax MCP server configuration.
ICTFAX_BASE_URL=https://your-ictfax/api
ICTFAX_USERNAME=admin@example.com
ICTFAX_PASSWORD=change-me

# Optional: account id to send from (default 1).
# ICTFAX_ACCOUNT_ID=1

# Optional: unlock upload/send fax (dials a real number). Off by default.
# ICTFAX_MCP_ALLOW_WRITE=true

# Optional tuning.
# ICTFAX_TIMEOUT_MS=30000
# ICTFAX_TLS_INSECURE=false
